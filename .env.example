# Environment Configuration
ENVIRONMENT=development

# Firebase Settings
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Database Settings
DATABASE_URL=postgresql://user:password@localhost/auvra_db

# API Keys
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Google Gemini API Configuration (Free Tier - No Quota Issues!)
# Get your free API key from: https://aistudio.google.com/apikey
# Official docs: https://ai.google.dev/pricing - All models FREE for dev use
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash  # FREE: Hybrid reasoning model, best for production
# Alternative free models: gemini-2.0-flash, gemini-flash-latest, gemini-2.5-flash-lite

# Pinecone Settings
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# Redis Settings
REDIS_URL=redis://localhost:6379

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
